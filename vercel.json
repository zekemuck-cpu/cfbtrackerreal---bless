{
  "functions": {
    "api/cfb27/*.js": {
      "includeFiles": "node_modules/madden-franchise/data/**",
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
