rules_version = '2';

// CFB Dynasty Tracker — Firestore Security Rules
//
// Source-of-truth principles:
//   1. The `users/{uid}` doc is server-controlled for subscription fields.
//      The webhook (admin SDK, bypasses rules) writes tier / status / etc.
//      Clients can READ their own user doc but cannot WRITE the
//      subscription fields directly. They can write a small allowlisted
//      set of profile fields (none currently — leaving room).
//   2. Cloud dynasties are owned by `userId`. The owner can always READ
//      them (including after subscription lapse — needed for the
//      auto-export-to-local migration). Premium owners can WRITE.
//   3. Shared dynasties: any uid in `editors[]` has read + gameplay-write
//      access without needing their own premium (the owner pays for the
//      doc). Roles ARE enforced on the parent doc: regular members cannot
//      change `editors`/`coCommishes`/`userId` (no self-promotion);
//      co-commishes can manage members but not other co-commishes;
//      ownership transfer is owner-only and the new owner must be premium.
//      Destructive subcollection deletes are limited to owner + co-commish.
//   4. Public dynasties (`isPublic == true` with a `shareCode`) are
//      readable by anyone, including unauthenticated visitors. Only the
//      owner can flip the public flag, and only premium owners can
//      do so (sharing is a premium feature).
//   5. `webhookEvents` and `stripeEvents` are server-only — clients
//      can't read or write them.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Read an arbitrary user's subscription doc (missing -> {} -> not premium).
    function userSubData(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      return exists(userPath) ? get(userPath).data : {};
    }

    // Premium predicate over a user-doc data blob.
    //
    // Mirrors the client-side check in services/subscriptionService.js:
    //   - tier must be 'premium'
    //   - active / trialing: premium until currentPeriodEnd (if set)
    //   - past_due (transient card decline): premium ONLY while a bounded
    //     grace deadline (currentPeriodEnd) is still in the future. Unlike
    //     active/trialing, an ABSENT currentPeriodEnd does NOT pass for
    //     past_due — otherwise a failed-payment account would keep write
    //     access forever (audit finding H2). The webhook stamps a grace
    //     deadline into currentPeriodEnd on invoice.payment_failed.
    function isPremiumData(d) {
      let activeOrTrial = d.tier == 'premium'
        && (d.subscriptionStatus == 'active' || d.subscriptionStatus == 'trialing')
        && (!('currentPeriodEnd' in d) || d.currentPeriodEnd == null || d.currentPeriodEnd > request.time);
      let pastDueGrace = d.tier == 'premium'
        && d.subscriptionStatus == 'past_due'
        && ('currentPeriodEnd' in d) && d.currentPeriodEnd != null && d.currentPeriodEnd > request.time;
      return activeOrTrial || pastDueGrace;
    }

    function isPremium() {
      return isSignedIn() && isPremiumData(userSubData(request.auth.uid));
    }

    // Is the given uid (not necessarily the requester) premium? Used to
    // enforce that commish ownership can only be transferred to a member
    // who is themselves premium (they become the one paying for storage).
    function isPremiumUid(uid) {
      return isPremiumData(userSubData(uid));
    }

    // ─── users/{uid} ─────────────────────────────────────────────────
    // Read: only the owner.
    // Write: rejected from clients EXCEPT a narrow case — the owner may
    //   flip `pendingDowngrade` from true to false to signal that the
    //   client has finished auto-exporting cloud dynasties to local
    //   storage. Any other field change goes through the webhook
    //   (admin SDK, bypasses these rules) or the admin API.
    // Create / delete: server-only.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingDowngrade'])
        && request.resource.data.pendingDowngrade == false;

      allow create, delete: if false;
    }

    // ─── dynasties/{id} ──────────────────────────────────────────────
    // SHARING MODEL: every dynasty has an `editors[]` array of uids that
    // are allowed to read+write. Legacy solo dynasties auto-migrate on
    // load to `editors: [userId]`. Until that migration runs, the
    // owner's read still works via the legacy `userId` check.
    //
    // PREMIUM MODEL: only the OWNER needs premium (they pay for cloud
    // storage). Invited editors can write even on the free tier — their
    // commish is footing the storage bill.
    //
    // Read:
    //   - Legacy owner (resource.data.userId) — keeps pre-migration
    //     dynasties readable
    //   - Anyone in editors[] (post-migration; owner is included here)
    //   - Anyone (no auth required) for currently-public docs
    // Create:
    //   - Premium owner; userId must equal the requester (no impersonation)
    //   - storageType must be 'cloud'
    // Update:
    //   - Owner (must be premium — they pay for storage)
    //   - OR uid in editors[] (invited editors can write even on free tier)
    //   - OR a non-editor self-redeeming a valid invite (see below)
    //   - userId cannot be changed (ownership transfer is out of scope)
    // Delete:
    //   - Owner only
    match /dynasties/{dynastyId} {
      // Each allow-read covers one access vector (split form is needed
      // so Firestore can prove each query path's safety independently —
      // a single combined OR confuses the safe-query analyzer for
      // array-contains queries).
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;

      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.get('editors', []);

      allow read: if resource.data.isPublic == true;

      allow create: if isPremium()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.storageType == 'cloud';

      // Owner write — must be premium (paying for the cloud doc). Ownership
      // unchanged (transfer has its own branch below).
      allow update: if isPremium()
                    && isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;

      // Commish (ownership) transfer — only the current premium owner may
      // hand the dynasty to an EXISTING editor, and only to one who is
      // themselves premium (they take over the storage bill; transferring
      // to a free member would brick all writes — audit finding C4). Only
      // the membership/ownership fields may move in a transfer.
      allow update: if isPremium()
                    && isOwner(resource.data.userId)
                    && request.resource.data.userId != resource.data.userId
                    && request.resource.data.userId in resource.data.get('editors', [])
                    && isPremiumUid(request.resource.data.userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['userId', 'editors', 'coCommishes', 'memberTeams', 'updatedAt']);

      // Co-commish write — premium NOT required (owner foots the storage
      // bill). Co-commishes shepherd the league: they may edit gameplay
      // data and manage members (editors / memberTeams), but may NOT
      // promote/demote co-commishes (commish-only) or change ownership.
      // isPublic/shareCode are owner-only (rules principle #4): without this
      // guard any invited member could publish the whole league to the world
      // (every subcollection's anonymous read keys off isPublic == true).
      allow update: if isSignedIn()
                    && !isOwner(resource.data.userId)
                    && request.auth.uid in resource.data.get('coCommishes', [])
                    && request.resource.data.userId == resource.data.userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['coCommishes', 'userId', 'isPublic', 'shareCode']);

      // Regular member write — premium NOT required. Members write gameplay
      // data (scores, rankings, ready-state) and may claim their own team
      // via memberTeams (self-onboarding). They may NOT touch editors,
      // coCommishes, or userId — that's what stopped any member from
      // self-promoting to co-commish or seizing the league (audit C1).
      // (Leaving — removing only themselves — has its own branch below.)
      allow update: if isSignedIn()
                    && !isOwner(resource.data.userId)
                    && request.auth.uid in resource.data.get('editors', [])
                    && !(request.auth.uid in resource.data.get('coCommishes', []))
                    && request.resource.data.userId == resource.data.userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['editors', 'coCommishes', 'userId', 'isPublic', 'shareCode']);

      // Member self-leave — any member may drop ONLY their own uid from the
      // membership arrays (editors/coCommishes) and their memberTeams slot.
      // Verified by: the diff touches only membership fields, this uid is
      // gone from the new editors/coCommishes, and editors shrank by exactly
      // one (so they can't remove anyone else under cover of leaving).
      allow update: if isSignedIn()
                    && !isOwner(resource.data.userId)
                    && request.auth.uid in resource.data.get('editors', [])
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['editors', 'coCommishes', 'memberTeams', 'updatedAt'])
                    && !(request.auth.uid in request.resource.data.get('editors', []))
                    && !(request.auth.uid in request.resource.data.get('coCommishes', []))
                    && request.resource.data.get('editors', []).size()
                         == resource.data.get('editors', []).size() - 1;

      // Invite redemption — a non-editor adds themselves to editors[]
      // by presenting a token. The token is verified via the invites
      // subcollection (see below): rules check that the doc at
      // dynasties/{id}/invites/{token} (a) exists, (b) is unredeemed,
      // (c) is unexpired, (d) was just marked redeemedBy this uid in
      // the same client batch.
      //
      // The client passes the token in `request.resource.data.lastRedemption.token`.
      // It's a transient marker (cleared on the next ordinary editor write)
      // that pins down WHICH invite is being claimed, since rules can't
      // iterate the invites subcollection.
      allow update: if isSignedIn()
                    && !(request.auth.uid in resource.data.get('editors', []))
                    && request.resource.data.userId == resource.data.userId
                    // Only editors and lastRedemption can change in a redemption.
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['editors', 'lastRedemption'])
                    // The new editors[] is the old list with EXACTLY this user appended.
                    && request.resource.data.editors.size() == resource.data.get('editors', []).size() + 1
                    && request.auth.uid in request.resource.data.editors
                    // The marker must name THIS user.
                    && request.resource.data.lastRedemption.uid == request.auth.uid
                    // The invite doc must exist, be redeemed by this uid, and unexpired.
                    && exists(/databases/$(database)/documents/dynasties/$(dynastyId)/invites/$(request.resource.data.lastRedemption.token))
                    && get(/databases/$(database)/documents/dynasties/$(dynastyId)/invites/$(request.resource.data.lastRedemption.token)).data.redeemedBy == request.auth.uid;

      allow delete: if isOwner(resource.data.userId);

      // Subcollections inherit the same access vectors. Owner needs
      // premium (storage cost); invited editors write freely.
      function parentDynasty() {
        return get(/databases/$(database)/documents/dynasties/$(dynastyId)).data;
      }

      match /players/{playerId} {
        allow read: if isSignedIn()
                    && parentDynasty().userId == request.auth.uid;
        allow read: if isSignedIn()
                    && request.auth.uid in parentDynasty().get('editors', []);
        allow read: if parentDynasty().isPublic == true;

        // Owner write requires premium; invited editors don't.
        allow write: if isPremium()
                     && parentDynasty().userId == request.auth.uid;
        // Owner can always DELETE their own dynasty's docs (teardown),
        // even if premium has lapsed. You can always remove your own
        // data; premium only gates create/update (storage cost) above.
        allow delete: if isSignedIn()
                      && parentDynasty().userId == request.auth.uid;
        // Invited editors may create/update (delete is granted below too).
        allow create, update: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
        // Any invited editor may also delete — members edit exactly like
        // the commish (trusted-league model). Roster/schedule/season edits
        // legitimately delete docs (orphan cleanup, removed games), so
        // gating delete to co-commishes blocked normal member editing.
        allow delete: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
      }

      match /games/{gameId} {
        allow read: if isSignedIn()
                    && parentDynasty().userId == request.auth.uid;
        allow read: if isSignedIn()
                    && request.auth.uid in parentDynasty().get('editors', []);
        allow read: if parentDynasty().isPublic == true;

        // Write model: everyone with access edits like the commish.
        // Owner write requires premium (they pay for storage); any invited
        // editor writes/deletes ANY game with no premium and no per-team
        // gate. A dynasty is a trusted group — there are no gameplay
        // permission tiers. (The old per-team gate blocked members from
        // ever saving a schedule, since the schedule save rewrites the
        // WHOLE game set, all teams + orphan cleanup, not just their own.)

        // Owner write — premium required.
        allow write: if isPremium()
                     && parentDynasty().userId == request.auth.uid;
        // Owner can always DELETE their own dynasty's docs (teardown),
        // even if premium has lapsed.
        allow delete: if isSignedIn()
                      && parentDynasty().userId == request.auth.uid;

        // Any invited editor (member or co-commish) — full write + delete,
        // any team, no premium.
        allow write: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
      }

      // ─── Season-scoped data (subcollection) ─────────────────────
      // Per-year docs: dynasties/{id}/seasons/{year}
      // Holds every field that used to live on the main doc as a
      // ByYear or ByTeamYear map (allAmericans, awards, conference
      // standings, recruitingCommitmentsByTeam, schedulesByTeam, etc).
      //
      // Rationale: long-running dynasties were pushing the parent
      // doc past the 1 MiB Firestore cap. Sharding the season-scoped
      // data into per-year docs keeps each doc well under the cap
      // regardless of how many seasons accumulate.
      //
      // Same access model as players/games/weekRecaps: owner needs
      // premium, invited editors can write without their own
      // subscription (the parent dynasty's premium covers storage).
      match /seasons/{seasonId} {
        allow read: if isSignedIn()
                    && parentDynasty().userId == request.auth.uid;
        allow read: if isSignedIn()
                    && request.auth.uid in parentDynasty().get('editors', []);
        allow read: if parentDynasty().isPublic == true;

        allow write: if isPremium()
                     && parentDynasty().userId == request.auth.uid;
        // Owner can always DELETE their own dynasty's docs (teardown),
        // even if premium has lapsed. You can always remove your own
        // data; premium only gates create/update (storage cost) above.
        allow delete: if isSignedIn()
                      && parentDynasty().userId == request.auth.uid;
        // Invited editors may create/update (delete is granted below too).
        allow create, update: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
        // Any invited editor may also delete — members edit exactly like
        // the commish (trusted-league model). Roster/schedule/season edits
        // legitimately delete docs (orphan cleanup, removed games), so
        // gating delete to co-commishes blocked normal member editing.
        allow delete: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
      }

      // ─── Week recaps (subcollection) ────────────────────────────
      // Per-week AI recap docs: dynasties/{id}/weekRecaps/{year-week}
      // Doc shape: { year, week, generatedAt, text }
      //
      // Lifted out of the main dynasty doc because long-running
      // dynasties were pushing the parent past the 1 MB Firestore size
      // cap, at which point ALL writes to the dynasty failed. Same
      // read/write model as players: owner needs premium, invited
      // editors can write without their own subscription.
      match /weekRecaps/{recapId} {
        allow read: if isSignedIn()
                    && parentDynasty().userId == request.auth.uid;
        allow read: if isSignedIn()
                    && request.auth.uid in parentDynasty().get('editors', []);
        allow read: if parentDynasty().isPublic == true;

        allow write: if isPremium()
                     && parentDynasty().userId == request.auth.uid;
        // Owner can always DELETE their own dynasty's docs (teardown),
        // even if premium has lapsed. You can always remove your own
        // data; premium only gates create/update (storage cost) above.
        allow delete: if isSignedIn()
                      && parentDynasty().userId == request.auth.uid;
        // Invited editors may create/update (delete is granted below too).
        allow create, update: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
        // Any invited editor may also delete — members edit exactly like
        // the commish (trusted-league model). Roster/schedule/season edits
        // legitimately delete docs (orphan cleanup, removed games), so
        // gating delete to co-commishes blocked normal member editing.
        allow delete: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
      }

      // ─── Recruiting Database (subcollection) ────────────────────
      // One doc per recruit: dynasties/{id}/recruitingDatabase/{pid}
      // Holds the recruits imported/scouted into a dynasty's Recruiting
      // Database — previously a plain array field on the main doc
      // (recruitingDatabasePlayers), moved out for the same 1 MB-cap
      // reason as players/games/weekRecaps/seasons above. Same access
      // model as those: owner needs premium, invited editors can write
      // without their own subscription.
      match /recruitingDatabase/{recruitId} {
        allow read: if isSignedIn()
                    && parentDynasty().userId == request.auth.uid;
        allow read: if isSignedIn()
                    && request.auth.uid in parentDynasty().get('editors', []);
        allow read: if parentDynasty().isPublic == true;

        allow write: if isPremium()
                     && parentDynasty().userId == request.auth.uid;
        // Owner can always DELETE their own dynasty's docs (teardown),
        // even if premium has lapsed. You can always remove your own
        // data; premium only gates create/update (storage cost) above.
        allow delete: if isSignedIn()
                      && parentDynasty().userId == request.auth.uid;
        // Invited editors may create/update.
        allow create, update: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
        // Any invited editor may also delete — members edit exactly like
        // the commish (trusted-league model), and batch edits / imports
        // legitimately remove recruit docs.
        allow delete: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
      }

      // ─── Team Future (Scheme Builder depth-chart plans) ─────────
      // One doc per tid: dynasties/{id}/teamFuture/{tid}. Previously a
      // single object field on the main doc (teamFuture), moved out for
      // the same 1 MB-cap reason as players/games/recruitingDatabase
      // above — a whole-league CFB27 sync writes every team's plan at
      // once. Same access model as recruitingDatabase.
      match /teamFuture/{tid} {
        allow read: if isSignedIn()
                    && parentDynasty().userId == request.auth.uid;
        allow read: if isSignedIn()
                    && request.auth.uid in parentDynasty().get('editors', []);
        allow read: if parentDynasty().isPublic == true;

        allow write: if isPremium()
                     && parentDynasty().userId == request.auth.uid;
        // Owner can always DELETE their own dynasty's docs (teardown),
        // even if premium has lapsed.
        allow delete: if isSignedIn()
                      && parentDynasty().userId == request.auth.uid;
        allow write: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
      }

      // ─── Recruiting Classes (whole-league named rosters) ────────
      // One doc per (tid, year): dynasties/{id}/recruitingClasses/{tid}_
      // {year} — dynasty.teams[tid].byYear[year].recruitingClassRoster.
      // Same 1 MB-cap reason as teamFuture above, but per-team-PER-YEAR
      // granularity instead of teamFuture's per-team-only: this data is
      // year-scoped and unboundedly accumulates every season like players/
      // games, so a whole-league sync's named rosters need that same finer
      // granularity — one shared per-year doc (unlike teamFuture, which has
      // no year dimension) was still too much for ~130 teams to share.
      // Same access model as teamFuture.
      match /recruitingClasses/{docId} {
        allow read: if isSignedIn()
                    && parentDynasty().userId == request.auth.uid;
        allow read: if isSignedIn()
                    && request.auth.uid in parentDynasty().get('editors', []);
        allow read: if parentDynasty().isPublic == true;

        allow write: if isPremium()
                     && parentDynasty().userId == request.auth.uid;
        // Owner can always DELETE their own dynasty's docs (teardown),
        // even if premium has lapsed.
        allow delete: if isSignedIn()
                      && parentDynasty().userId == request.auth.uid;
        allow write: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
      }

      // ─── Social Media feature subcollections ────────────────────
      // socialFeed/{year-week} (posts) and socialCharacters/shard-N +
      // _overrides (the per-dynasty character overlay). Same access
      // vectors as weekRecaps: owner (premium) + invited editors write,
      // owner / editors / public read.
      match /socialFeed/{docId} {
        allow read: if isSignedIn()
                    && parentDynasty().userId == request.auth.uid;
        allow read: if isSignedIn()
                    && request.auth.uid in parentDynasty().get('editors', []);
        allow read: if parentDynasty().isPublic == true;

        allow write: if isPremium()
                     && parentDynasty().userId == request.auth.uid;
        // Owner can always DELETE their own dynasty's docs (teardown),
        // even if premium has lapsed. You can always remove your own
        // data; premium only gates create/update (storage cost) above.
        allow delete: if isSignedIn()
                      && parentDynasty().userId == request.auth.uid;
        // Invited editors may create/update (delete is granted below too).
        allow create, update: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
        // Any invited editor may also delete — members edit exactly like
        // the commish (trusted-league model). Roster/schedule/season edits
        // legitimately delete docs (orphan cleanup, removed games), so
        // gating delete to co-commishes blocked normal member editing.
        allow delete: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
      }

      match /socialCharacters/{docId} {
        allow read: if isSignedIn()
                    && parentDynasty().userId == request.auth.uid;
        allow read: if isSignedIn()
                    && request.auth.uid in parentDynasty().get('editors', []);
        allow read: if parentDynasty().isPublic == true;

        allow write: if isPremium()
                     && parentDynasty().userId == request.auth.uid;
        // Owner can always DELETE their own dynasty's docs (teardown),
        // even if premium has lapsed. You can always remove your own
        // data; premium only gates create/update (storage cost) above.
        allow delete: if isSignedIn()
                      && parentDynasty().userId == request.auth.uid;
        // Invited editors may create/update (delete is granted below too).
        allow create, update: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
        // Any invited editor may also delete — members edit exactly like
        // the commish (trusted-league model). Roster/schedule/season edits
        // legitimately delete docs (orphan cleanup, removed games), so
        // gating delete to co-commishes blocked normal member editing.
        allow delete: if isSignedIn()
                     && parentDynasty().userId != request.auth.uid
                     && request.auth.uid in parentDynasty().get('editors', []);
      }

      // ─── Invite tokens (subcollection) ──────────────────────────
      // Token-keyed docs: dynasties/{id}/invites/{token}
      // Doc shape: { role, createdBy, createdAt, expiresAt?, label?,
      //              redeemedBy?, redeemedAt? }
      //
      // get: any signed-in user can fetch ONE invite by its exact token
      //   (URL-shared join page). Non-editors can't enumerate.
      // list: editors only — the Members page subscribes to this
      //   collection so the commish can see + revoke pending invites.
      // create/delete: editors only (commish + co-commishes generate
      //   and revoke invites).
      // update: redemption only — anyone signed in can mark an
      //   unredeemed, unexpired invite as redeemed by themselves. The
      //   actual editors[] write happens on the parent dynasty doc
      //   (see the redemption rule above).
      match /invites/{token} {
        allow get: if isSignedIn();

        // Owner always counts as an editor even if the legacy doc never
        // populated editors[] — protects dynasty deletion + invite mgmt
        // for accounts that pre-date the editors-array migration.
        allow list: if isSignedIn()
                    && (request.auth.uid == parentDynasty().userId
                        || request.auth.uid in parentDynasty().get('editors', []));

        allow create, delete: if isSignedIn()
                              && (request.auth.uid == parentDynasty().userId
                                  || request.auth.uid in parentDynasty().get('editors', []));

        allow update: if isSignedIn()
                      && resource.data.redeemedBy == null
                      && (
                        !('expiresAt' in resource.data)
                        || resource.data.expiresAt == null
                        || resource.data.expiresAt > request.time
                      )
                      && request.resource.data.redeemedBy == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedBy', 'redeemedAt']);
      }
    }

    // ─── Server-only collections ─────────────────────────────────────
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    // ─── Default deny ────────────────────────────────────────────────
    // Any collection not explicitly allowed above is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
